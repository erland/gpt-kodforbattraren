{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodforbattraren.local/schemas/source-manifest.schema.json",
  "title": "Kodförbättraren Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "files",
    "root_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "algorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "root_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
